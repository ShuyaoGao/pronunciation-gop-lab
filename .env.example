# AI 语言听说测评工具（完整版）—— 可选环境变量示例
# 注意：本项目不会自动读取 .env 文件，请在启动前于终端里设置，例如 PowerShell：
#   $env:OPENAI_API_KEY = "你的key"; python src/app.py
# 真实密钥不要写进任何会提交的文件（.env 已在 .gitignore 中）。

# 发音模型（默认 vitouphy/wav2vec2-xls-r-300m-timit-phoneme，首次运行自动下载约 1.2GB）
AISPEAK_MODEL=vitouphy/wav2vec2-xls-r-300m-timit-phoneme
# 推理设备：cpu（默认）或 cuda
AISPEAK_DEVICE=cpu
# 国内下载 HuggingFace 模型慢时可用镜像
HF_ENDPOINT=https://hf-mirror.com

# 可选：AI 对话陪练（OpenAI 兼容接口；本地 Ollama 填 http://localhost:11434/v1）
OPENAI_API_KEY=
OPENAI_BASE_URL=
AISPEAK_LLM_MODEL=gpt-4o-mini

# 可选：Azure 发音评测对照（会把录音发往云端，默认关闭）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
